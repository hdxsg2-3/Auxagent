# 复制本文件为 .env 并填入你自己的密钥
# .env 已被 .gitignore 忽略，不会上传到 GitHub
#
# 注意：变量名必须与 backend/config.py 读取的名称一致，写错会静默失效。

# ---- 方舟大模型（必填，不填则所有 AI 能力不可用）----
ARK_API_KEY=your-ark-api-key-here
API_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3
MODEL_NAME=ep-xxxxxxxx
TEMPERATURE=0.7
MAX_TOKENS=4096
TIMEOUT=300

# ---- 火山引擎内容安全 / 翻译（选填，不填则对应能力降级）----
VOLC_CONTENT_AK=
VOLC_CONTENT_SK=
VOLC_CONTENT_APP_ID=
VOLC_TRANS_AK=
VOLC_TRANS_SK=

# ---- 服务运行参数（服务器由 systemd 注入，本地开发可留空）----
SECRET_KEY=
LOG_LEVEL=INFO
LOG_FILE=
