# 复制本文件为 .env 并填入你自己的密钥
# .env 已被 .gitignore 忽略，不会上传到 GitHub
ARK_API_KEY=your-ark-api-key-here
ARK_API_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL_NAME=ep-xxxx
ARK_TEMPERATURE=0.7
ARK_MAX_TOKENS=2000
ARK_TIMEOUT=120
VOLC_CONTENT_AK=your-volc-content-ak
VOLC_CONTENT_SK=your-volc-content-sk
VOLC_TRANS_AK=your-volc-trans-ak
VOLC_TRANS_SK=your-volc-trans-sk
VOLC_CONTENT_APP_ID=your-content-security-app-id
